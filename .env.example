# =========================================================================
# FlashCompare AI — Environment Configuration Example (.env.example)
# Duplicate this file to .env and fill in real production values.
# NEVER commit the real .env file with secrets to GitHub!
# =========================================================================

# --- BACKEND SERVER SETTINGS (for Render / Host) ---
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secure_secret_key_minimum_32_characters

# The public URL of your deployed Netlify frontend (for CORS security):
# Example: https://your-site-name.netlify.app or * for open testing
CORS_ORIGIN=http://localhost:5173

# --- FRONTEND CLIENT SETTINGS (for Netlify / Local Vite) ---
# When running locally, this can remain empty to use Vite's local /api proxy.
# In production on Netlify, set this to your backend service URL (e.g. https://flashcompare-api.onrender.com)
VITE_API_URL=
